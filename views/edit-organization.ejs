<%- include('partials/header') %>

<main class="content-block">
  <h1><%= typeof title !== 'undefined' ? title : 'Edit Organization' %></h1>
  <p class="subtitle">Update the details of this organization.</p>

  <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
    <div class="alert alert-error" role="alert">
      <ul>
        <% errors.forEach(function(error) { %>
          <li><%= error %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form action="/edit-organization/<%= organizationDetails.organization_id %>" method="POST" class="form-card" novalidate>
    <div class="form-group">
      <label for="name">Organization Name</label>
      <input
        type="text"
        id="name"
        name="name"
        value="<%= organizationDetails.name %>"
        required
        maxlength="150"
      />
      <small class="form-hint">Required, 3–150 characters.</small>
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea
        id="description"
        name="description"
        required
        maxlength="500"
        rows="4"
      ><%= organizationDetails.description %></textarea>
      <small class="form-hint">Required, max 500 characters.</small>
    </div>

    <div class="form-group">
      <label for="contactEmail">Contact Email</label>
      <input
        type="email"
        id="contactEmail"
        name="contactEmail"
        value="<%= organizationDetails.contact_email %>"
        required
      />
    </div>

    <div class="form-group">
      <label for="location">Location</label>
      <input
        type="text"
        id="location"
        name="location"
        value="<%= organizationDetails.location %>"
        required
        maxlength="150"
      />
    </div>

    <div class="form-group">
      <label for="logoFilename">Logo Filename</label>
      <input
        type="text"
        id="logoFilename"
        name="logoFilename"
        value="<%= organizationDetails.logo_filename %>"
        maxlength="255"
      />
    </div>

    <div class="form-actions">
      <button type="submit" class="btn-primary">Update Organization</button>
      <a href="/organization/<%= organizationDetails.organization_id %>" class="btn-secondary">Cancel</a>
    </div>
  </form>
</main>

<%- include('partials/footer') %>
