<%- include('partials/header') %>

<main class="content-block">
  <h1><%= typeof title !== 'undefined' ? title : 'Add New Category' %></h1>
  <p class="subtitle">Create a new service category by providing a category name.</p>

  <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
    <div class="alert alert-error" role="alert">
      <ul>
        <% errors.forEach(function(error) { %>
          <li><%= error %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form action="/new-category" method="POST" class="form-card" novalidate>
    <div class="form-group">
      <label for="name">Category Name</label>
      <input
        type="text"
        id="name"
        name="name"
        value="<%= typeof formData !== 'undefined' && formData.name ? formData.name : '' %>"
        required
        maxlength="100"
        placeholder="e.g. Community Outreach"
      />
      <small class="form-hint">Required, max 100 characters.</small>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn-primary">Create Category</button>
      <a href="/categories" class="btn-secondary">Cancel</a>
    </div>
  </form>
</main>

<%- include('partials/footer') %>
