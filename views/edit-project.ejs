<%- include('partials/header') %>

<main class="content-block">
  <h1><%= typeof title !== 'undefined' ? title : 'Edit Service Project' %></h1>
  <p class="subtitle">Update the details of this service project.</p>

  <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
    <div class="alert alert-error" role="alert">
      <ul>
        <% errors.forEach(function(error) { %>
          <li><%= error %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <form action="/edit-project/<%= project.project_id %>" method="POST" class="form-card" novalidate>
    <div class="form-group">
      <label for="title">Project Title</label>
      <input
        type="text"
        id="title"
        name="title"
        value="<%= project.name %>"
        required
        maxlength="200"
      />
      <small class="form-hint">Required, 3–200 characters.</small>
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea
        id="description"
        name="description"
        required
        maxlength="1000"
        rows="4"
      ><%= project.description %></textarea>
      <small class="form-hint">Required, max 1000 characters.</small>
    </div>

    <div class="form-group">
      <label for="location">Location</label>
      <input
        type="text"
        id="location"
        name="location"
        value="<%= project.location %>"
        required
        maxlength="200"
      />
    </div>

    <div class="form-group">
      <label for="date">Start Date</label>
      <input
        type="date"
        id="date"
        name="date"
        value="<%= project.start_date ? new Date(project.start_date).toISOString().split('T')[0] : '' %>"
        required
      />
    </div>

    <div class="form-group">
      <label for="organizationId">Organization</label>
      <select id="organizationId" name="organizationId" required>
        <option value="">-- Select an organization --</option>
        <% (typeof organizations !== 'undefined' ? organizations : []).forEach(function(org) { %>
          <option
            value="<%= org.organization_id %>"
            <%= String(project.organization_id) === String(org.organization_id) ? 'selected' : '' %>
          ><%= org.name %></option>
        <% }) %>
      </select>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn-primary">Update Project</button>
      <a href="/project/<%= project.project_id %>" class="btn-secondary">Cancel</a>
    </div>
  </form>
</main>

<%- include('partials/footer') %>
